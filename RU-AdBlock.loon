#!name=RU AdBlock
#!desc=Профессиональная блокировка рекламы для русскоязычных сайтов v3.2
#!author=Professional AdBlock Team
#!homepage=https://github.com/Lexanewmsk/loon-configuration-file
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AdBlocking.png
#!date=2025-01-01
#!select=HTTPS редиректы, Включить, Отключить  
#!select=Очистка HTML, Включить, Отключить
#!select=Антитрекинг, Включить, Отключить
#!select=Блокировка соцсетей, Отключить, Включить
#!select=Дебаг логи, Отключить, Включить

[General]
# Принудительное использование HTTP движка для MITM
force-http-engine-hosts = %APPEND% *.ru, *.рф, *.com.ru, *.net.ru, *.org.ru, *.yandex.*, *.vk.com, *.mail.ru, *.ok.ru, *.dzen.ru, *.dzeninfra.ru, *.avito.ru, *.ozon.ru, *.wildberries.ru, *.goldapple.ru

[Rule]
# =====================================
# DNS БЛОКИРОВКА (БЫСТРАЯ)
# =====================================

# Google реклама
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT  
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,googletagservices.com,REJECT
DOMAIN-SUFFIX,adsystem.google.com,REJECT

# Яндекс реклама
DOMAIN,bs.yandex.ru,REJECT
DOMAIN,an.yandex.ru,REJECT
DOMAIN,yabs.yandex.ru,REJECT
DOMAIN,awaps.yandex.ru,REJECT
DOMAIN-SUFFIX,adfox.ru,REJECT
DOMAIN-SUFFIX,adfox.yandex.ru,REJECT
DOMAIN-SUFFIX,yandexadexchange.net,REJECT

# Яндекс.Дзен реклама
DOMAIN,clck.dzen.ru,REJECT  
DOMAIN,an.dzen.ru,REJECT
DOMAIN,ads.dzen.ru,REJECT
DOMAIN-SUFFIX,dzeninfra.ru,REJECT
DOMAIN,static.dzeninfra.ru,REJECT

# Mail.ru реклама
DOMAIN,go.mail.ru,REJECT
DOMAIN,rs.mail.ru,REJECT
DOMAIN,top.mail.ru,REJECT

# VK реклама
DOMAIN,ads.vk.com,REJECT
DOMAIN-KEYWORD,vk.com/ads,REJECT

# RTB платформы
DOMAIN-SUFFIX,relap.io,REJECT
DOMAIN-SUFFIX,buzzoola.com,REJECT
DOMAIN-SUFFIX,marketgid.com,REJECT
DOMAIN-SUFFIX,mgid.com,REJECT
DOMAIN-SUFFIX,smi2.net,REJECT
DOMAIN-SUFFIX,smi2.ru,REJECT
DOMAIN-SUFFIX,outbrain.com,REJECT
DOMAIN-SUFFIX,taboola.com,REJECT

# Рамблер
DOMAIN,top100.rambler.ru,REJECT
DOMAIN,counter.rambler.ru,REJECT
DOMAIN,ssp.rambler.ru,REJECT
DOMAIN,nova.rambler.ru,REJECT

# Аналитика
DOMAIN,mc.yandex.ru,REJECT
DOMAIN,metrika.yandex.ru,REJECT
DOMAIN,informer.yandex.ru,REJECT
DOMAIN-SUFFIX,google-analytics.com,REJECT
DOMAIN-SUFFIX,googleanalytics.com,REJECT

# Facebook трекинг
DOMAIN-SUFFIX,connect.facebook.net,REJECT
DOMAIN-KEYWORD,facebook.com/tr,REJECT

# Дополнительные рекламные сети
DOMAIN-SUFFIX,betweendigital.com,REJECT
DOMAIN-SUFFIX,videonow.ru,REJECT
DOMAIN-SUFFIX,advmaker.net,REJECT
DOMAIN-SUFFIX,adriver.ru,REJECT
DOMAIN-SUFFIX,begun.ru,REJECT

# Криптомайнинг
DOMAIN-SUFFIX,coinhive.com,REJECT
DOMAIN-SUFFIX,coin-hive.com,REJECT
DOMAIN-SUFFIX,jsecoin.com,REJECT
DOMAIN-SUFFIX,crypto-loot.com,REJECT

# Ключевые слова в доменах
DOMAIN-KEYWORD,doubleclick,REJECT
DOMAIN-KEYWORD,googleads,REJECT
DOMAIN-KEYWORD,googlesyndication,REJECT
DOMAIN-KEYWORD,yandexadexchange,REJECT
DOMAIN-KEYWORD,adfox,REJECT

# URL паттерны
URL-REGEX,^https?://[^/]+/ads/,REJECT
URL-REGEX,^https?://[^/]+/banner,REJECT
URL-REGEX,^https?://[^/]+/reklama,REJECT
URL-REGEX,^https?://ads\.,REJECT

# Яндекс специфичные
URL-REGEX,^https?://yandex\.[^/]+/an/,REJECT
URL-REGEX,^https?://[^/]+\.yandex\.[^/]+/(bs|yabs|awaps)/,REJECT

# Дзен специфичные
URL-REGEX,^https?://dzen\.ru/.*\?(adb-bits|test-tag|ctime),REJECT
URL-REGEX,^https?://[^/]*dzeninfra\.ru/.*/zen-lib/,REJECT
URL-REGEX,^https?://clck\.dzen\.ru/,REJECT

# Трекинг параметры
URL-REGEX,[?&](utm_source|utm_medium|utm_campaign|utm_content|utm_term)=,REJECT
URL-REGEX,[?&](fbclid|gclid|yclid|_openstat)=,REJECT

[Script]
# =====================================
# ОСНОВНАЯ ОБРАБОТКА
# =====================================

# Универсальный паттерн для ВСЕХ .ru доменов (включая основные)
http-request ^https?://[^/]+\.(ru|рф|com\.ru|net\.ru|org\.ru) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=🚫 RU AdBlock Request

http-response ^https?://[^/]+\.(ru|рф|com\.ru|net\.ru|org\.ru) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=🧹 RU AdBlock Response

# Яндекс сервисы (упрощенный паттерн)
http-request ^https?://[^/]*(yandex|ya)\.(ru|com|net|by|kz|ua) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=🟨 Yandex Block

http-response ^https?://[^/]*(yandex|ya)\.(ru|com|net|by|kz|ua) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=🟨 Yandex Clean

# VK.com (упрощенный)
http-request ^https?://[^/]*vk\.com script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=🟦 VK Block

http-response ^https?://[^/]*vk\.com script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=🟦 VK Clean

# Mail.ru (упрощенный)
http-request ^https?://[^/]*mail\.ru script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=📧 Mail.ru Block

http-response ^https?://[^/]*mail\.ru script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=📧 Mail.ru Clean

# Яндекс.Дзен (упрощенный)
http-request ^https?://[^/]*(dzen|dzeninfra)\.ru script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=📰 Dzen Block

http-response ^https?://[^/]*(dzen|dzeninfra)\.ru script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=📰 Dzen Clean

# Новостные сайты (упрощенный)
http-request ^https?://[^/]*(lenta|rbc|kommersant|vedomosti|forbes|ria|tass|interfax|gazeta|kp|mk)\.(ru|com) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=📰 News Block

http-response ^https?://[^/]*(lenta|rbc|kommersant|vedomosti|forbes|ria|tass|interfax|gazeta|kp|mk)\.(ru|com) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=📰 News Clean

# Маркетплейсы (упрощенный)
http-request ^https?://[^/]*(avito|youla|ozon|wildberries|lamoda|citilink|dns-shop|mvideo|eldorado|goldapple)\.(ru|com) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=🛒 Shop Block

http-response ^https?://[^/]*(avito|youla|ozon|wildberries|lamoda|citilink|dns-shop|mvideo|eldorado|goldapple)\.(ru|com) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=🛒 Shop Clean

# Развлечения (упрощенный)
http-request ^https?://[^/]*(pikabu|habr|vc|dtf|tjournal|kinopoisk|ivi|okko|start|more)\.(ru|com|tv) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=🎮 Entertainment Block

http-response ^https?://[^/]*(pikabu|habr|vc|dtf|tjournal|kinopoisk|ivi|okko|start|more)\.(ru|com|tv) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=🎮 Entertainment Clean

# HTTP->HTTPS редиректы (упрощенный)
http-request ^http://[^/]+\.(ru|рф|com\.ru|net\.ru|org\.ru) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=5, tag=🔒 HTTPS Redirect

# Международная реклама (упрощенный)
http-request ^https?://[^/]+(doubleclick|googlesyndication|googleadservices|googletagmanager) script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=5, tag=🌍 Global Ads

[MITM]
# =====================================
# MITM ХОСТЫ
# =====================================

hostname = %APPEND% *.ru, *.рф, *.com.ru, *.net.ru, *.org.ru,

# Яндекс
*.yandex.ru, *.yandex.net, *.yandex.com, *.yandex.by, *.yandex.kz, *.yandex.ua,
*.ya.ru, yandex.ru, ya.ru,
*.yastatic.net, yastatic.net,
*.yandexadexchange.net,
*.adfox.ru, *.adfox.yandex.ru,

# Яндекс.Дзен
*.dzen.ru, dzen.ru,
*.dzeninfra.ru, dzeninfra.ru,
clck.dzen.ru, an.dzen.ru, ads.dzen.ru,

# VK
*.vk.com, vk.com, *.vkontakte.ru, vkontakte.ru,
*.userapi.com, *.vkuseraudio.net, *.vkuser.net,

# Mail.ru
*.mail.ru, mail.ru,
*.my.mail.ru, *.e.mail.ru, *.touch.mail.ru,
*.mradx.net, *.imgsmail.ru,
*.ok.ru, ok.ru, *.odnoklassniki.ru,

# Новости
*.lenta.ru, *.rbc.ru, *.kommersant.ru, *.vedomosti.ru,
*.ria.ru, *.tass.ru, *.interfax.ru, *.rt.com,
*.gazeta.ru, *.kp.ru, *.mk.ru, *.forbes.ru,

# Маркетплейсы
*.avito.ru, *.youla.ru, *.drom.ru, *.auto.ru,
*.ozon.ru, *.wildberries.ru, *.lamoda.ru,
*.citilink.ru, *.dns-shop.ru, *.mvideo.ru, *.eldorado.ru,
*.goldapple.ru, goldapple.ru, *.app.goldapple.ru,

# Развлечения
*.pikabu.ru, *.habr.com, *.vc.ru, *.dtf.ru, *.tjournal.ru,
*.kinopoisk.ru, *.ivi.ru, *.okko.tv, *.start.ru, *.more.tv,
*.rutube.ru, *.music.yandex.ru,

# Банки
*.sberbank.ru, *.vtb.ru, *.tinkoff.ru, *.alfabank.ru,
*.raiffeisen.ru, *.unicreditbank.ru, *.rosbank.ru,

# Сервисы
*.2gis.ru, *.gosuslugi.ru, *.nalog.ru,
*.hh.ru, *.superjob.ru, *.rabota.ru,

# Рекламные домены
*.doubleclick.net, *.googlesyndication.com, *.googleadservices.com,
*.googletagmanager.com, *.google-analytics.com,
*.facebook.com, *.fbcdn.net,
*.relap.io, *.buzzoola.com, *.marketgid.com, *.mgid.com,
*.smi2.net, *.smi2.ru, *.outbrain.com, *.taboola.com,
*.betweendigital.com, *.videonow.ru, *.advmaker.net,

# Трекинг
*.mc.yandex.ru, *.metrika.yandex.ru,
*.top100.rambler.ru, *.counter.rambler.ru,
*.hotlog.ru, *.liveinternet.ru, *.rating.mail.ru
