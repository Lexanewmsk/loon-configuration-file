#!name=RU AdBlock
#!desc=Система блокировки рекламы для русскоязычных сайтов v4.0
#!author=Professional AdBlock Team
#!homepage=https://github.com/Lexanewmsk/loon-configuration-file
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AdBlocking.png
#!select=HTTPS редиректы, Включить, Отключить  
#!select=Очистка HTML, Включить, Отключить
#!select=Антитрекинг, Включить, Отключить
#!select=Дебаг логи, Отключить, Включить

[General]
# Принудительное использование HTTP движка для MITM
force-http-engine-hosts = %APPEND% *.ru, *.рф, *.yandex.ru, *.vk.com, *.mail.ru, *.ok.ru, *.dzen.ru, *.4pda.to

[Script]
# =====================================
# ИНТЕЛЛЕКТУАЛЬНАЯ БЛОКИРОВКА
# =====================================

# Основная обработка запросов для .ru доменов
http-request ^https?://.*\.ru/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=🚫 RU AdBlock Request, enable=true

# Обработка запросов для .to доменов (4pda и другие)
http-request ^https?://.*\.to/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=🚫 TO AdBlock Request, enable=true

# HTTP->HTTPS принудительные редиректы
http-request ^http://.*\.ru/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=5, tag=🔒 HTTPS Redirect, enable=true

# Очистка HTML контента от рекламы
http-response ^https?://.*\.ru/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=🧹 HTML Cleaner RU, enable=true

http-response ^https?://.*\.to/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=🧹 HTML Cleaner TO, enable=true

# Специальная обработка для популярных сайтов
http-request ^https?://.*(yandex|vk|mail|ok|pikabu|habr|lenta|rbc|dzen|4pda)\.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=🎯 Popular Sites, enable=true

http-response ^https?://.*(yandex|vk|mail|ok|pikabu|habr|lenta|rbc|dzen|4pda)\.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=🎯 Popular Sites Response, enable=true

# Блокировка международной рекламы на русских сайтах
http-request ^https?://.*\.(doubleclick|googlesyndication|googleadservices|facebook|outbrain|taboola)\..*/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=5, tag=🌍 International Ads, enable=true

# Яндекс.Дзен специальная обработка
http-request ^https?://.*dzen(infra)?\.ru/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=false, timeout=10, tag=📰 Dzen AdBlock, enable=true

http-response ^https?://.*dzen(infra)?\.ru/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock.js, requires-body=true, timeout=15, tag=📰 Dzen Clean, enable=true

[MITM]
# =====================================
# MITM ХОСТЫ
# =====================================

# Основные .ru домены
hostname = *.ru, *.рф,

# Популярные русские сайты
*.yandex.ru, *.ya.ru, 
*.vk.com, *.vkontakte.ru,
*.mail.ru, *.my.mail.ru,
*.ok.ru, *.odnoklassniki.ru,

# Яндекс.Дзен
*.dzen.ru, *.dzeninfra.ru,

# Форумы и медиа
*.4pda.to, *.4pda.ru,

# Новости и медиа
*.lenta.ru, *.rbc.ru, *.kommersant.ru,
*.ria.ru, *.tass.ru, *.interfax.ru,
*.gazeta.ru, *.kp.ru, *.mk.ru,

# Торговля (работающие)
*.ozon.ru, *.wildberries.ru, *.citilink.ru, *.dns-shop.ru,

# Развлечения
*.pikabu.ru, *.habr.com, *.vc.ru,
*.kinopoisk.ru, *.ivi.ru, *.start.ru,
*.music.yandex.ru,

# Банки и финансы  
*.sberbank.ru, *.vtb.ru, *.tinkoff.ru,
*.alfabank.ru, *.raiffeisen.ru,

# Рекламные домены для перехвата
*.adfox.ru, *.adfox.yandex.ru,
*.bs.yandex.ru, *.an.yandex.ru,
*.relap.io, *.buzzoola.com,
*.doubleclick.net, *.googlesyndication.com,
xray.mail.ru, r0.mail.ru, r.mail.ru

# ИСКЛЮЧЕНИЯ - НЕ добавляем в MITM:
# *.gosuslugi.ru - государственные услуги
# *.esia.gosuslugi.ru - авторизация госуслуг  
# *.avito.ru - проблемы с работой
# *.lamoda.ru - проблемы с API
# *.goldapple.ru - полное исключение
# *.okcdn.ru - CDN соцсетей
# *.vkcdn.net - CDN соцсетей
# passport.yandex.ru - авторизация Яндекс
