#!name=RU Clean URL
#!desc=Очистка URL от трекинга и блокировка рекламы v1.0
#!author=Professional AdBlock Team
#!homepage=https://github.com/Lexanewmsk/loon-configuration-file
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AdBlocking.png
#!select=Дебаг логи, Отключить, Включить
#!select=Очистка HTML, Отключить, Включить
#!select=Очистка URL, Включить, Отключить

[General]
# Принудительное использование HTTP движка для обработки
force-http-engine-hosts = %APPEND% *.ru, *.com, *.to

[Script]
# =====================================
# ОЧИСТКА URL ОТ ТРЕКИНГА
# =====================================

# Очистка трекинг параметров из всех URL
http-request ^https?://.*\?(.*&)?(utm_|fbclid|yclid|gclid|_ga).* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-Clean-URL.js, requires-body=false, timeout=5, tag=🧹 URL Clean Tracking, enable=true

# Очистка параметров Яндекса
http-request ^https?://.*\?(.*&)?(_openstat|from=).* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-Clean-URL.js, requires-body=false, timeout=5, tag=🧹 URL Clean Yandex, enable=true

# =====================================
# БЛОКИРОВКА РЕКЛАМЫ
# =====================================

# Блокировка рекламных директорий
http-request ^https?://.*/(ads|banner|reklama|promo)/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-Clean-URL.js, requires-body=false, timeout=5, tag=🚫 Ads Block, enable=true

# Блокировка трекинга
http-request ^https?://.*(metrika|analytics|counter|pixel|beacon)/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-Clean-URL.js, requires-body=false, timeout=5, tag=🚫 Tracking Block, enable=true

# Блокировка рекламных доменов
http-request ^https?://.*(googlesyndication|doubleclick|adfox|yabs\.yandex)\.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-Clean-URL.js, requires-body=false, timeout=5, tag=🚫 Ad Domains Block, enable=true

# =====================================
# ОЧИСТКА HTML (ОПЦИОНАЛЬНО)
# =====================================

# Очистка HTML от рекламы
http-response ^https?://.*\.(ru|com|to)/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-Clean-URL.js, requires-body=true, timeout=10, tag=🧹 HTML Clean, enable=true

[MITM]
# =====================================
# MITM ХОСТЫ
# =====================================

hostname = *.ru, *.com, *.to

# Автоматически исключаются через скрипт:
# - gosuslugi.ru
# - банковские домены
# - yandex.ru, dzen.ru (особая обработка)
