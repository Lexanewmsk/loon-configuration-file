#!name=RU AdBlock Lite
#!desc=Универсальная блокировка рекламы v2.0
#!author=Professional AdBlock Team
#!homepage=https://github.com/Lexanewmsk/loon-configuration-file
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AdBlocking.png
#!select=Дебаг логи, Отключить, Включить
#!select=Очистка HTML, Включить, Отключить

[General]
# Принудительное использование HTTP движка для всех .ru и .to доменов
force-http-engine-hosts = %APPEND% *.ru, *.to, *.com

[Script]
# =====================================
# УНИВЕРСАЛЬНАЯ БЛОКИРОВКА
# =====================================

# Блокировка рекламных URL паттернов - для всех сайтов
http-request ^https?://.*/(ads|banner|reklama|promo)/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock-Lite.js, requires-body=false, timeout=5, tag=🚫 Universal Ads Block, enable=true

# Блокировка трекинга и аналитики
http-request ^https?://.*(metrika|analytics|counter|metric|pixel|beacon)/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock-Lite.js, requires-body=false, timeout=5, tag=🚫 Tracking Block, enable=true

# Блокировка известных рекламных доменов
http-request ^https?://.*(googlesyndication|doubleclick|adfox|yabs\.yandex)\.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock-Lite.js, requires-body=false, timeout=5, tag=🚫 Ad Domains Block, enable=true

# Очистка HTML от рекламы - универсальная для всех сайтов
http-response ^https?://.*\.(ru|to|com)/.* script-path=https://raw.githubusercontent.com/Lexanewmsk/loon-configuration-file/refs/heads/loon/RU-AdBlock-Lite.js, requires-body=true, timeout=10, tag=🧹 Universal HTML Clean, enable=true

[MITM]
# =====================================
# MITM ДЛЯ ПОПУЛЯРНЫХ ДОМЕНОВ
# =====================================

hostname = *.ru, *.to, *.com

# Автоматически исключаются через скрипт:
# - gosuslugi.ru (государственные услуги)
# - банковские домены (sberbank, vtb, tinkoff)
# - yandex.ru, dzen.ru (особая обработка)
# - lamoda.ru, avito.ru, goldapple.ru (по запросу)
