#!name=URL Cleaner (RU + Global)
#!desc=Remove tracking parameters from URLs (Russian + International sites)
#!author=Based on proven solutions
#!homepage=https://github.com/Lexanewmsk/loon-configuration-file
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Clean.png

[URL Rewrite]
# ===== GLOBAL TRACKING PARAMETERS =====

# Google UTM & Analytics (most common)
^https?://([^/]+)/([^?]*).*[?&]utm_source=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]utm_medium=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]utm_campaign=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]utm_term=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]utm_content=[^&]*(.*)$ https://$1/$2$3 302

# Google Ads
^https?://([^/]+)/([^?]*).*[?&]gclid=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]gclsrc=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]dclid=[^&]*(.*)$ https://$1/$2$3 302

# Facebook & Meta
^https?://([^/]+)/([^?]*).*[?&]fbclid=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]fb_ref=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]fb_source=[^&]*(.*)$ https://$1/$2$3 302

# Twitter
^https?://([^/]+)/([^?]*).*[?&]twsrc=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]ref_src=[^&]*(.*)$ https://$1/$2$3 302

# ===== RUSSIAN TRACKING PARAMETERS =====

# Yandex (Russian equivalent of Google)
^https?://([^/]+)/([^?]*).*[?&]yclid=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]_openstat=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]from=[^&]*(.*)$ https://$1/$2$3 302

# Mail.ru
^https?://([^/]+)/([^?]*).*[?&]mailru=[^&]*(.*)$ https://$1/$2$3 302

# VK.com (VKontakte)
^https?://([^/]+)/([^?]*).*[?&]vk_ref=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]z=[^&]*(.*)$ https://$1/$2$3 302

# ===== EMAIL MARKETING =====
^https?://([^/]+)/([^?]*).*[?&]mc_cid=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]mc_eid=[^&]*(.*)$ https://$1/$2$3 302

# ===== GENERAL TRACKING =====
^https?://([^/]+)/([^?]*).*[?&]ref=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]source=[^&]*(.*)$ https://$1/$2$3 302
^https?://([^/]+)/([^?]*).*[?&]campaign=[^&]*(.*)$ https://$1/$2$3 302

# ===== CLEANUP EMPTY PARAMETERS =====
# Remove dangling ? or & 
^https?://([^/]+)/([^?]*)\?&+(.*)$ https://$1/$2?$3 302
^https?://([^/]+)/([^?]*)\?$  https://$1/$2 302
^https?://([^/]+)/([^?]*)&+(.*)$ https://$1/$2$3 302
