#!name=URL Cleaner
#!desc=Remove tracking parameters from URLs
#!author=Lexanewmsk
#!homepage=https://github.com/Lexanewmsk/loon-configuration-file
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Clean.png

[URL Rewrite]
# Google Analytics & UTM parameters
^(https?://[^?]+)\?([^#]*&)?utm_source=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?utm_medium=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?utm_campaign=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?utm_term=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?utm_content=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302

# Google Ads
^(https?://[^?]+)\?([^#]*&)?gclid=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?gclsrc=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?dclid=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?_ga=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302

# Facebook
^(https?://[^?]+)\?([^#]*&)?fbclid=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?fb_ref=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?fb_source=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302

# Yandex
^(https?://[^?]+)\?([^#]*&)?yclid=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?_openstat=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302

# Email marketing
^(https?://[^?]+)\?([^#]*&)?mc_cid=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?mc_eid=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?campaign_id=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302

# Social media
^(https?://[^?]+)\?([^#]*&)?ref=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?referrer=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?source=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?medium=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302

# HubSpot
^(https?://[^?]+)\?([^#]*&)?_hsenc=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?_hsmi=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302

# Affiliate tracking
^(https?://[^?]+)\?([^#]*&)?affiliate=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?partner=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302

# A/B Testing
^(https?://[^?]+)\?([^#]*&)?variant=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302
^(https?://[^?]+)\?([^#]*&)?ab_test=[^&#]*(&[^#]*)?(\#.*)?$ $1?$2$3$4 302

# Clean empty query strings
^(https?://[^?]+)\?(&+)?(\#.*)?$ $1$3 302
^(https?://[^?]+)\?$  $1 302
