#!name=Simple URL Cleaner Test
#!desc=Simplified rules for testing
#!author=Test version

[URL Rewrite]

# Простые правила для тестирования
^https?://([^/]+)/?(.*)\?(.*)yclid=[^&]*&?(.*)$ https://$1/$2?$3$4 302
^https?://([^/]+)/?(.*)\?(.*)from=[^&]*&?(.*)$ https://$1/$2?$3$4 302
^https?://([^/]+)/?(.*)\?(.*)fbclid=[^&]*&?(.*)$ https://$1/$2?$3$4 302
^https?://([^/]+)/?(.*)\?(.*)gclid=[^&]*&?(.*)$ https://$1/$2?$3$4 302

# Очистка пустых параметров
^https?://([^/]+)/?(.*)\?&+(.*)$ https://$1/$2?$3 302
^https?://([^/]+)/?(.*)\?&*$ https://$1/$2 302
^https?://([^/]+)/?(.*)\?$ https://$1/$2 302
