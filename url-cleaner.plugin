# ===== ОЧИСТКА ПУСТЫХ ПАРАМЕТРОВ =====
# Удалить висячие символы ? или &
^https?://([^/]+)/([^?]*)\?&+(.*)$ https://$1/$2?$3 302
^https?://([^/]+)/([^?]*)\?&*$ https://$1/$2 302
^https?://([^/]+)/([^?]*)\?$ https://$1/$2 302
^https?://([^/]+)/([^?]*)\?(.*)&+$ https://$1/$2?$3 302
^https?://([^/]+)/([^?]*)&+(.*)$ https://$1/$2?$3 302

