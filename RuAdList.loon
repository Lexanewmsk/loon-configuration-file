# AdProfex / ads2.bid
^https?:\/\/.*\/json\/\?.*=.*%2C690% - reject
^https?:\/\/.*\/json\/\?user_id=.*&site_id=.*&blocks= - reject

# Rezka.ag video ads
^https?:\/\/.*\/point\/\?method=video_link&xl= - reject

# AdsWell vendor libs
^https?:\/\/.*\.xyz\/vendor\/lib\/ - reject

# Generic L tag ads
