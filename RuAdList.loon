#!name= RuAdList для Loon
#!desc= Конвертированные правила из AdGuard RuAdList - Common banner names
#!author= AdguardTeam (конвертация для Loon)
#!homepage= https://github.com/AdguardTeam/AdguardFilters
#!icon= https://raw.githubusercontent.com/AdguardTeam/AdguardFilters/master/BaseFilter/metadata.json

[Rule]
# Пока нет безопасных доменов для блокировки из этого блока

[Rewrite]
# === Common banner names - Generic blocking rules ===

# Video streaming ads
^https?:\/\/.*\/code\/video-steam\/\?id=.*&vast= - reject

# Nadavi ads
^https?:\/\/.*\/nadavi-api\/\?p4g3=js\/api\/widget\.js - reject

# AJ bid ads
^https?:\/\/aj.*\.bid\/.*\?vpaid= - reject

# Email spam shop/tb
^https?:\/\/.*\.shop\/tb\/ - reject

# HDVB player 1xbet
^https?:\/\/.*\/content\/stream\/1xbet\/ - reject

# RTB Kodik instream
^https?:\/\/.*\/rtb\/kodik_instream\? - reject

# Load XML ads
^https?:\/\/.*\/load-xml\/\?id=.*&roll= - reject

# AdFactor services
^https?:\/\/.*\.com\/services\/\?id= - reject

# Mobiads.pro sticker
^https?:\/\/.*\/resources\/js\/sticker\.js\? - reject

# External subid ads
^https?:\/\/.*\.xml\?v=3\.0&external_subid= - reject

# Rutor mirrors
^https?:\/\/.*\/esh-kichum\.js - reject

# Lucky ads feed
^https?:\/\/.*\/\.feed\/v5\/ad\?stream_uuid= - reject
^https?:\/\/.*\?surfer_uuid=.*&block_uuid= - reject
^https?:\/\/.*\/confirm\/ad\?uuid - reject
^https?:\/\/.*\/confirm\/block\?uuid= - reject

# AdProfex / ads2.bid
^https?:\/\/.*\/json\/\?.*=.*%2C690% - reject
^https?:\/\/.*\/json\/\?user_id=.*&site_id=.*&blocks= - reject

# Rezka.ag video ads
^https?:\/\/.*\/point\/\?method=video_link&xl= - reject

# AdsWell vendor libs
^https?:\/\/.*\.xyz\/vendor\/lib\/ - reject

# Generic L tag ads
^https?:\/\/.*\/L\?tag=.*&ad= - reject
^https?:\/\/.*\/L\?tag=.*_clickunder& - reject

# V3 PHP ads
^https?:\/\/.*\/j\/v3\.php\?id= - reject

# MBP pre ads
^https?:\/\/.*\/mbp\/pre\/ - reject

# WCM ads
^https?:\/\/.*\/wcm\/\?sh= - reject

# Goto sitereg ads
^https?:\/\/.*\/\?goto=sitereg&atp=.*&plid=.*&bnid= - reject

# jQuery min fake
^https?:\/\/.*\/jquerymin18\.js - reject

# NeverBlock
^https?:\/\/.*\/nb\/fl\.js - reject

# Universal scripts ads
^https?:\/\/.*\/api\/scripts\/universal\?id= - reject

# uBar.pro
^https?:\/\/.*\/appUbarButton\.js - reject

# Offergate.pro
^https?:\/\/.*\/api\/content\/js\?blockid=.*&sourceid= - reject

# DIV DA ads
^https?:\/\/.*&div=DIV_DA_ - reject

# Luntic ads
^https?:\/\/.*\/luntic\.php\?q= - reject

# Utarget JS
^https?:\/\/.*\/js\/utarget\.js - reject

# 404 ASCII art ads
^https?:\/\/.*\?uid=.*&p=.*&fmt=.*&box_border=.*&fghover= - reject

# Context PHP ads
^https?:\/\/.*\.ru\/js\/context\.php\?id=.*&c= - reject
^https?:\/\/.*\.com\/rq\.jsp\? - reject

# Armi.media bbqcode
^https?:\/\/.*\/bbqcode\?saitDomain=.*&referrer=.*&clientWidth= - reject

# X-TDS ads
^https?:\/\/.*-tds\.com\/\?id=.*&h=.*&l=.*&r= - reject

# Webmasterskyi draw ad script
^https?:\/\/.*\/resources\/draw_ad_script\.js - reject

# === Additional blocking rules ===

# Site JS with referrer
^https?:\/\/.*\.site\/.*\.js\?referrer= - reject

# XYZ get code
^https?:\/\/.*\.xyz\/get_code\?w= - reject

# MBP/CU/DBP pre ads with SID
^https?:\/\/.*\/mbp\/pre\/.*\?sid= - reject
^https?:\/\/.*\/cu\/pre\/.*\?sid= - reject
^https?:\/\/.*\/dbp\/pre\/ - reject

# jQuery fake with ref
^https?:\/\/.*\/jquery-2\.3\.1\.min\.js\?ref=.*&pef= - reject

# uCoz/Clan.su ads - specific scripts
^https?:\/\/.*\/\.s\/src\/crit_image\.js - reject
^https?:\/\/.*\/\.s\/src\/aw3bg1vw57wwpi\.js - reject
^https?:\/\/.*\/\.s\/src\/5bs387qwpyw73\.js - reject
^https?:\/\/.*\/\.s\/src\/282bde48fz\.js - reject
^https?:\/\/.*\/\.s\/src\/a3gj754wp9t73\.js - reject
^https?:\/\/.*\/\.s\/flash\/bnr\/ - reject

# uCoz utils
^https?:\/\/ucoz\..*\/cgi\/uutils\.fcg\?.*&r= - reject

# uCoz random script patterns
^https?:\/\/.*ucoz\..*\/\?.*%21.*%3B - reject

# Bpoint ads
^https?:\/\/.*\.ru\/bpoint\/src\/vvpl\.js\? - reject
^https?:\/\/.*\.ru\/bpoint\/bnr\/blocks\/vastvpaid_player\.js - reject

# Various encoded ads
^https?:\/\/.*\/avXntA\/ik47z\/4I4Irk\?%21 - reject
^https?:\/\/.*\/clan\.su\/\?[A-Za-z0-9]+%21.*%5E\/ - reject
^https?:\/\/.*\/porebl\/\?Izo84uQ4=.*% - reject
^https?:\/\/.*\/tG3a8U7s\/\?x37gWsOk= - reject
^https?:\/\/.*\/uglobjs\/\?w3j0s9tL= - reject

# uCoz vastvpaid player
^https?:\/\/ucoz\.net\/bnr\/blocks\/vastvpaid_player\.js - reject

# Dear/Embed code goclick
^https?:\/\/.*\/dear_code\/.*\/goclick\?t=.*&ref= - reject
^https?:\/\/.*\/embed_code\/.*\/goclick\?t=.*&ref= - reject

# PP.ua scripts
^https?:\/\/.*\.pp\.ua - reject

# CSP scripts
^https?:\/\/csp-.*\.ru\/ - reject

# Resources with key
^https?:\/\/.*\.ru\/resources\?key= - reject

# Medicine teaser ads (various patterns)
^https?:\/\/.*\.info\/v2\/show\/\?.*=.*&.*&.*= - reject
^https?:\/\/.*\.info\/show\/\?.*=.*&.*=.*&.*=.*%20.*%20.*& - reject
^https?:\/\/.*\.ru\/show\/\?.*=.*&.*=.*&.*=.*%20.*%20.*& - reject
^https?:\/\/.*\.ru\/show\/\?.*=.*&.*=.*%D0.*\|%20.*& - reject
^https?:\/\/.*\.ru\/show\/\?.*&block_id= - reject
^https?:\/\/.*\.ru\/show\/\?.*=.*&.*=.*&.*=.*& - reject
^https?:\/\/.*\.ru\/show\/\?.*=.*=.*&.*=.*::.*& - reject
^https?:\/\/.*\.ru\/show\/\?block_id= - reject
